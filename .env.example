# Copy this file to ".env" in the repo root and replace the placeholders.
# ".env" is git-ignored; never commit real values.

# REQUIRED - PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# If the password has special characters, URL-encode them (for example "@" becomes "%40").
# "npm run db:setup" creates the database if it does not exist, so USER needs permission to create databases.
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/sweety

# OPTIONAL - the values below are the defaults used when a variable is missing.

# Port for the Express API.
PORT=4000

# Origin of the React dev server (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# IANA time zone that defines "today" (see the README, section "Time zone").
APP_TIMEZONE=Asia/Kolkata

# Set to "production" when serving over HTTPS: the session cookie then becomes Secure-only.
# NODE_ENV=production

# Copy this file to .env (in the repo root) and fill in your values.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/sweety

# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# The calendar date "today" is computed in this IANA time zone (see README)
APP_TIMEZONE=Asia/Kolkata
